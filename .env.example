# --- Core ---
APP_ENV=production
BETA_MODE=false
PUBLIC_IP=178.47.143.15
PUBLIC_WEB_ORIGIN=https://shnenepepe.online
PUBLIC_API_ORIGIN=https://api.shnenepepe.online
GAME_DOMAIN=shnenepepe.ru
NODE_HOSTNAME=node1.shnenepepe.ru
MC_ROUTER_ASLEEP_MOTD=Сервер спит. Зайдите ещё раз, чтобы разбудить его.

# --- Secrets (generate unique values) ---
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-to-64-random-bytes
INTERNAL_BOT_TOKEN=change-me

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- YooKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://shnenepepe.online/payments/return
YOOKASSA_IP_CHECK=true

# --- Cloudflare (zone shnenepepe.ru) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- CurseForge ---
CURSEFORGE_API_KEY=

# --- Modrinth ---
MODRINTH_USER_AGENT=shnenepepe-hosting/1.0.0 (https://shnenepepe.online)

# --- Host paths (Linux production) ---
MC_SERVERS_ROOT=/var/mc_hosting/servers
DOCKER_NETWORK=mc-router-net

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://orchestrator:${DB_PASSWORD}@postgres:5432/mc_platform
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CORS_ORIGINS=https://shnenepepe.online,https://api.shnenepepe.online
TRUSTED_PROXIES=cloudflare
